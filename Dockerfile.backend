# Dockerfile for Sentri Code Express API & Sandboxed Code Runner
FROM node:22-alpine

# Install Python 3 and create python symlink for the sandboxed runner engine
RUN apk add --no-cache python3 py3-pip && ln -sf /usr/bin/python3 /usr/bin/python

WORKDIR /app

COPY package*.json ./
RUN npm ci

# Copy server and configuration files
COPY server ./server
COPY tsconfig.json ./

# Create data directory for persistent SQLite database
RUN mkdir -p /app/server/data

ENV PORT=4000
ENV NODE_ENV=production

EXPOSE 4000

CMD ["npm", "run", "server"]
